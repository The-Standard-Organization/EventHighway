@namespace EventHighway.Portal.Web.Views.Components.Foundations.Dashboards
@using EventHighway.Core.Models.Coordinations.HealthChecks.V2
@using EventHighway.Portal.Web.Views.Bases

<div class="d-flex align-items-center gap-2 @(Disabled ? "opacity-50" : "")">
    <div class="btn-group btn-group-sm" role="group">
        @foreach (TrafficPeriodV2 candidate in Periods)
        {
            <Button Color="@(candidate == Period ? "primary" : "outline-secondary")"
                    CssClass="btn-sm"
                    Disabled="Disabled"
                    OnClick="@(() => OnPeriod(candidate))">
                @candidate.ToString()
            </Button>
        }
    </div>

    @if (Period == TrafficPeriodV2.Custom)
    {
        <div class="d-flex align-items-center gap-1 custom-range-pickers">
            <FormDate Value="WindowStart" ValueChanged="OnCustomStartChanged" />
            <span class="small">–</span>
            <FormDate Value="InclusiveEnd" ValueChanged="OnCustomEndChanged" />
        </div>
    }
    else
    {
        <Button Color="outline-secondary" CssClass="btn-sm" Disabled="Disabled" OnClick="OnPrev">‹</Button>
        <span class="small text-nowrap">@WindowLabel</span>

        <Button Color="outline-secondary" CssClass="btn-sm" Disabled="@(Disabled || !CanGoNext)"
                OnClick="OnNext">›</Button>

        <Button Color="outline-secondary" CssClass="btn-sm" Disabled="Disabled" OnClick="OnCurrent">
            Current
        </Button>
    }
</div>

@code {
    [Parameter] public TrafficPeriodV2 Period { get; set; }
    [Parameter] public DateTimeOffset WindowStart { get; set; }
    [Parameter] public DateTimeOffset? WindowEnd { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool CanGoNext { get; set; }

    [Parameter] public EventCallback<TrafficPeriodV2> PeriodChanged { get; set; }
    [Parameter] public EventCallback<(DateTimeOffset Start, DateTimeOffset End)> CustomRangeChanged { get; set; }
    [Parameter] public EventCallback PreviousRequested { get; set; }
    [Parameter] public EventCallback NextRequested { get; set; }
    [Parameter] public EventCallback CurrentRequested { get; set; }

    private static readonly TrafficPeriodV2[] Periods =
    {
        TrafficPeriodV2.Day,
        TrafficPeriodV2.Week,
        TrafficPeriodV2.Month,
        TrafficPeriodV2.Year,
        TrafficPeriodV2.Custom
    };

    private string WindowLabel =>
        WindowEnd.HasValue
            ? WindowNavigator.Label(Period, WindowStart, WindowEnd.Value)
            : WindowNavigator.Label(Period, WindowStart);

    // The "to" picker shows the inclusive last day of the window; the window end stays exclusive.
    private DateTimeOffset? InclusiveEnd =>
        (WindowEnd ?? WindowStart.AddDays(7)).AddDays(-1);

    private async Task OnPeriod(TrafficPeriodV2 period) => await PeriodChanged.InvokeAsync(period);

    private async Task OnCustomStartChanged(DateTimeOffset? value)
    {
        if (value is null || Disabled)
        {
            return;
        }

        DateTimeOffset start = value.Value;
        DateTimeOffset end = WindowEnd ?? start.AddDays(7);

        if (end <= start)
        {
            end = start.AddDays(1);
        }

        await CustomRangeChanged.InvokeAsync((start, end));
    }

    private async Task OnCustomEndChanged(DateTimeOffset? value)
    {
        if (value is null || Disabled)
        {
            return;
        }

        DateTimeOffset end = value.Value.AddDays(1);
        DateTimeOffset start = WindowStart;

        if (end <= start)
        {
            start = end.AddDays(-1);
        }

        await CustomRangeChanged.InvokeAsync((start, end));
    }

    private async Task OnPrev() => await PreviousRequested.InvokeAsync();
    private async Task OnNext() => await NextRequested.InvokeAsync();
    private async Task OnCurrent() => await CurrentRequested.InvokeAsync();
}
